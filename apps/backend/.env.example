# Copy to apps/backend/.env (dev) or set in your host's environment (prod).

# "production" enables strict env validation, locked-down CORS and proxy trust.
NODE_ENV=development
PORT=5000

# PostgreSQL connection string. Add ?sslmode=require for hosted databases.
DATABASE_URL=postgresql://user:password@localhost:5432/gigsforgigs

# Required in production, min 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out and invalidates outstanding invite links.
JWT_SECRET=

# Public URL of the frontend. Used in manager/admin invite links. Required in production.
APP_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API. Defaults to APP_URL.
CORS_ORIGINS=

# Number of reverse proxies in front of the API (load balancer = 1). Defaults to 1 in production.
TRUST_PROXY=
