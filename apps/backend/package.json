{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "npm --prefix src/db install --include=dev && npm --prefix src/db run build",
    "typecheck": "tsc --noEmit -p .",
    "migrate:deploy": "prisma migrate deploy",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test src/lib/taskRules.test.ts src/lib/validation.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "db": "file:./src/db",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.12",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.0",
    "typescript": "^5.7.3"
  },
  "description": "",
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "engines": {
    "node": ">=20.19"
  }
