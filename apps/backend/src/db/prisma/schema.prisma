generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId          Int                     @id @default(autoincrement()) @map("user_id")
  name            String                  @db.VarChar(100)
  hashPassword    String                  @map("hash_password") @db.VarChar(100)
  email           String                  @unique @db.VarChar(100)
  role            Role
  createdAt       DateTime                @default(now()) @map("created_at")
  client          Client?
  gigProfile      GigProfessionalProfile?
  managerLink     Manager?
  reviewsReceived Review[]                @relation("Reviewee")
  reviewsGiven    Review[]                @relation("Reviewer")

  @@map("USERS")
}

model Client {
  clientId        Int              @id @default(autoincrement()) @map("client_id")
  userId          Int              @unique @map("user_id")
  clientName      String           @map("client_name") @db.VarChar(100)
  numberOfManager Int              @default(0) @map("number_of_manager")
  domain          String?          @db.VarChar(100)
  user            User             @relation(fields: [userId], references: [userId])
  managers        Manager[]
  managerInvites  ManagerInvite[]
  serviceRequests ServiceRequest[]
  tasks           Task[]

  @@map("CLIENT")
}

model Manager {
  clientId    Int                    @map("client_id")
  managerId   Int                    @unique @default(autoincrement()) @map("manager_id")
  userId      Int                    @unique @map("user_id")
  createdAt   DateTime               @default(now()) @map("created_at")
  assignments GigManagerAssignment[]
  client      Client                 @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [userId])

  @@id([clientId, managerId])
  @@map("MANAGER")
}

model GigProfessionalProfile {
  gigProfileId Int                    @id @default(autoincrement()) @map("gig_profile_id")
  userId       Int                    @unique @map("user_id")
  bio          String?
  applications Application[]
  deliverables Deliverable[]
  assignments  GigManagerAssignment[]
  user         User                   @relation(fields: [userId], references: [userId])
  payments     Payment[]
  portfolio    ProfilePortfolio[]
  skills       ProfileSkill[]
  tools        ProfileTool[]
  services     Service[]

  @@map("GIG_PROFESSIONAL_PROFILE")
}

model ProfileSkill {
  gigProfileId Int                    @map("gig_profile_id")
  skill        String                 @db.VarChar(100)
  profile      GigProfessionalProfile @relation(fields: [gigProfileId], references: [gigProfileId], onDelete: Cascade)

  @@id([gigProfileId, skill])
  @@map("PROFILE_SKILLS")
}

model ProfileTool {
  gigProfileId Int                    @map("gig_profile_id")
  tool         String                 @db.VarChar(100)
  profile      GigProfessionalProfile @relation(fields: [gigProfileId], references: [gigProfileId], onDelete: Cascade)

  @@id([gigProfileId, tool])
  @@map("PROFILE_TOOLS")
}

model ProfilePortfolio {
  gigProfileId Int                    @map("gig_profile_id")
  url          String                 @db.VarChar(500)
  profile      GigProfessionalProfile @relation(fields: [gigProfileId], references: [gigProfileId], onDelete: Cascade)

  @@id([gigProfileId, url])
  @@map("PROFILE_PORTFOLIO")
}

model Task {
  taskId       Int                    @id @default(autoincrement()) @map("task_id")
  clientId     Int                    @map("client_id")
  title        String                 @db.VarChar(255)
  description  String?
  budget       Decimal                @db.Decimal(10, 2)
  dueDate      DateTime?              @map("due_date") @db.Date
  status       TaskStatus             @default(open)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  category     String?                @db.VarChar(50)
  duration     String?                @db.VarChar(50)
  skills       String[]               @default([])
  applications Application[]
  deliverables Deliverable[]
  assignments  GigManagerAssignment[]
  payments     Payment[]
  reviews      Review[]
  client       Client                 @relation(fields: [clientId], references: [clientId])

  @@map("TASKS")
}

model Application {
  applicationId Int                    @id @default(autoincrement()) @map("application_id")
  gigProfileId  Int                    @map("gig_profile_id")
  taskId        Int                    @map("task_id")
  status        ApplicationStatus      @default(pending)
  createdAt     DateTime               @default(now()) @map("created_at")
  hourlyRate    Decimal?               @map("hourly_rate") @db.Decimal(8, 2)
  rating        Int?
  gigProfile    GigProfessionalProfile @relation(fields: [gigProfileId], references: [gigProfileId])
  task          Task                   @relation(fields: [taskId], references: [taskId])

  @@unique([gigProfileId, taskId], map: "uq_application")
  @@map("APPLICATION")
}

model GigManagerAssignment {
  gigProfileId Int                    @map("gig_profile_id")
  taskId       Int                    @map("task_id")
  managerId    Int                    @map("manager_id")
  assignedAt   DateTime               @default(now()) @map("assigned_at")
  deliverables Deliverable[]
  gigProfile   GigProfessionalProfile @relation(fields: [gigProfileId], references: [gigProfileId])
  manager      Manager                @relation(fields: [managerId], references: [managerId])
  task         Task                   @relation(fields: [taskId], references: [taskId])

  @@id([gigProfileId, taskId])
  @@map("GIG_MANAGER_ASSIGNMENT")
}

model Deliverable {
  taskId         Int                    @map("task_id")
  deliverableNo  Int                    @map("deliverable_no")
  gigProfileId   Int                    @map("gig_profile_id")
  description    String                 @db.VarChar(500)
  submissionPath String                 @map("submission_path") @db.VarChar(500)
  status         DeliverableStatus      @default(submitted)
  createdAt      DateTime               @default(now()) @map("created_at")
  feedback       String?                @db.VarChar(500)
  gigProfile     GigProfessionalProfile @relation(fields: [gigProfileId], references: [gigProfileId])
  assignment     GigManagerAssignment   @relation(fields: [gigProfileId, taskId], references: [gigProfileId, taskId])
  task           Task                   @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@id([taskId, deliverableNo])
  @@map("DELIVERABLE")
}

model Payment {
  paymentId    Int                    @id @default(autoincrement()) @map("payment_id")
  taskId       Int                    @map("task_id")
  gigProfileId Int                    @map("gig_profile_id")
  amount       Decimal                @db.Decimal(10, 2)
  status       PaymentStatus          @default(pending)
  createdAt    DateTime               @default(now()) @map("created_at")
  gigProfile   GigProfessionalProfile @relation(fields: [gigProfileId], references: [gigProfileId])
  task         Task                   @relation(fields: [taskId], references: [taskId])

  @@unique([taskId, gigProfileId], map: "uq_payment")
  @@map("PAYMENT")
}

model Review {
  reviewId   Int      @id @default(autoincrement()) @map("review_id")
  reviewerId Int      @map("reviewer_id")
  revieweeId Int      @map("reviewee_id")
  taskId     Int      @map("task_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [userId])
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [userId])
  task       Task     @relation(fields: [taskId], references: [taskId])

  @@unique([reviewerId, revieweeId, taskId], map: "uq_review")
  @@map("REVIEWS")
}

/// A service offered by a gig professional, browsable by clients.
model Service {
  serviceId    Int                    @id @default(autoincrement()) @map("service_id")
  gigProfileId Int                    @map("gig_profile_id")
  title        String                 @db.VarChar(255)
  description  String?
  price        Decimal                @db.Decimal(10, 2)
  thumbnail    String?                @db.VarChar(500)
  status       ServiceStatus          @default(active)
  createdAt    DateTime               @default(now()) @map("created_at")
  profile      GigProfessionalProfile @relation(fields: [gigProfileId], references: [gigProfileId], onDelete: Cascade)
  requests     ServiceRequest[]
  tags         ServiceTag[]

  @@map("SERVICE")
}

/// Free-form tags on a service. Mirrors the PROFILE_SKILLS join-table pattern.
model ServiceTag {
  serviceId Int     @map("service_id")
  tag       String  @db.VarChar(100)
  service   Service @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)

  @@id([serviceId, tag])
  @@map("SERVICE_TAGS")
}

/// A client requesting a gig professional's service. Distinct from APPLICATION,
/// which runs the other direction (gig professional applies to a client's task).
model ServiceRequest {
  requestId Int                  @id @default(autoincrement()) @map("request_id")
  serviceId Int                  @map("service_id")
  clientId  Int                  @map("client_id")
  status    ServiceRequestStatus @default(pending)
  createdAt DateTime             @default(now()) @map("created_at")
  client    Client               @relation(fields: [clientId], references: [clientId])
  service   Service              @relation(fields: [serviceId], references: [serviceId])

  @@unique([serviceId, clientId], map: "uq_service_request")
  @@map("SERVICE_REQUEST")
}

/// Stands alone by design: a client invites by name + email BEFORE a USERS row
/// exists, so this cannot hang off MANAGER (which requires a user_id).
/// On accept it records acceptedUserId and the MANAGER row is created.
model ManagerInvite {
  inviteId       Int          @id @default(autoincrement()) @map("invite_id")
  clientId       Int          @map("client_id")
  name           String       @db.VarChar(100)
  email          String       @db.VarChar(100)
  status         InviteStatus @default(pending)
  acceptedUserId Int?         @map("accepted_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  client         Client       @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@unique([clientId, email], map: "uq_manager_invite")
  @@map("MANAGER_INVITE")
}

enum Role {
  client
  gig_professional
  manager
  admin
}

enum TaskStatus {
  open
  in_progress
  completed
}

enum ApplicationStatus {
  pending
  accepted
  declined
  shortlisted
}

enum DeliverableStatus {
  submitted
  approved
  revision_requested
  closed
}

enum PaymentStatus {
  pending
  completed
  failed
}

enum ServiceStatus {
  active
  paused
  archived
}

enum ServiceRequestStatus {
  pending
  accepted
  declined
}

enum InviteStatus {
  pending
  accepted
  revoked
}
