{
  "info": {
    "name": "GigsForGigs API",
    "description": "Postman collection for the GigsForGigs NestJS backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "gigUserId",
      "value": "u3",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "u1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Gig Professional",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{gigUserId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/gig/profile",
              "host": ["{{baseUrl}}"],
              "path": ["gig", "profile"]
            }
          }
        },
        {
          "name": "Get Marketplace Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gig/tasks/marketplace",
              "host": ["{{baseUrl}}"],
              "path": ["gig", "tasks", "marketplace"]
            }
          }
        },
        {
          "name": "Apply to Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{gigUserId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"taskId\": \"tsk-1\"\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/gig/applications",
              "host": ["{{baseUrl}}"],
              "path": ["gig", "applications"]
            }
          }
        },
        {
          "name": "Get Pending Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{gigUserId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/gig/requests/pending",
              "host": ["{{baseUrl}}"],
              "path": ["gig", "requests", "pending"]
            }
          }
        },
        {
          "name": "Get Active Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{gigUserId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/gig/tasks/active",
              "host": ["{{baseUrl}}"],
              "path": ["gig", "tasks", "active"]
            }
          }
        }
      ]
    },
    {
      "name": "Client",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"client_id\": \"{{clientId}}\",\r\n  \"title\": \"Build a React Dashboard\",\r\n  \"description\": \"I need a responsive dashboard built using React and TailwindCSS.\",\r\n  \"budget\": 1200\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "Get Client Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?clientId={{clientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                {
                  "key": "clientId",
                  "value": "{{clientId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Applications for Task",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications?taskId=tsk-1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications"],
              "query": [
                {
                  "key": "taskId",
                  "value": "tsk-1"
                }
              ]
            }
          }
        },
        {
          "name": "Assign Task (Accept App)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"gig_profile_id\": \"{{gigUserId}}\",\r\n  \"manager_id\": \"mgr-1\"\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/tsk-1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "tsk-1"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Gig Profiles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/gig-profiles",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "gig-profiles"]
            }
          }
        },
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dashboard", "stats"]
            }
          }
        }
      ]
    }
  ]
}
